/* === Layout Animation demo === */

.layout-anim-panel {
    background: var(--blue-muted);
    border-radius: 8px;
    padding: 16px;
}

.layout-anim-content {
    background: var(--bg-overlay);
    border-radius: 6px;
    padding: 12px;
}

.layout-anim-box {
    background: var(--accent);
    border-radius: 6px;
}

.layout-anim-box-green {
    background: var(--success);
    border-radius: 6px;
}

.layout-anim-box-purple {
    background: var(--purple);
    border-radius: 6px;
}

.layout-anim-box-amber {
    background: var(--warning);
    border-radius: 6px;
}

.layout-anim-accordion-header {
    background: var(--bg-elevated);
    border-radius: 6px;
    padding: 10px;
}

.layout-anim-accordion-body {
    background: var(--bg-overlay);
    border-radius: 0px 0px 6px 6px;
    padding: 12px;
}
