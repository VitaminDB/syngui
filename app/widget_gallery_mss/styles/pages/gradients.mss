/* === Gradients === */

.gradient-horizontal {
    background: linear-gradient(90deg, #3b82f6, #8b5cf6);
    border-radius: 8px;
}

.gradient-vertical {
    background: linear-gradient(180deg, #f43f5e, #fb923c);
    border-radius: 8px;
}

.gradient-diagonal {
    background: linear-gradient(135deg, #667eea, #764ba2);
    border-radius: 8px;
}

.gradient-to-top {
    background: linear-gradient(0deg, #0ea5e9, #22d3ee);
    border-radius: 8px;
}

.gradient-rainbow {
    background: linear-gradient(90deg, #ef4444, #f97316, #eab308, #22c55e, #3b82f6, #8b5cf6);
    border-radius: 8px;
}

.gradient-sunset {
    background: linear-gradient(135deg, #ff6b6b, #feca57, #ff9ff3);
    border-radius: 8px;
}

.gradient-ocean {
    background: linear-gradient(180deg, #0077b6, #00b4d8, #90e0ef);
    border-radius: 8px;
}

.gradient-radial {
    background: radial-gradient(circle at center, var(--bg-surface), #3b82f6);
    border-radius: 8px;
}

.gradient-radial-ellipse {
    background: radial-gradient(ellipse at center, #fde68a, #f59e0b);
    border-radius: 8px;
}

.gradient-rounded {
    background: linear-gradient(90deg, #ec4899, #8b5cf6);
    border-radius: 12px;
}

.gradient-pill {
    background: linear-gradient(90deg, #14b8a6, #06b6d4);
    border-radius: 40px;
}

.gradient-bordered {
    background: linear-gradient(135deg, #6366f1, #a855f7);
    border-radius: 8px;
    border: 2px solid var(--indigo);
}

.gradient-card-purple {
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    border-radius: 12px;
}

.gradient-card-blue {
    background: linear-gradient(135deg, #2563eb, #06b6d4);
    border-radius: 12px;
}

.gradient-card-green {
    background: linear-gradient(135deg, #059669, #34d399);
    border-radius: 12px;
}
