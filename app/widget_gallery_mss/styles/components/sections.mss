/* === Section cards & labels === */

.section-card {
    background: var(--bg-surface);
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 4px 16px var(--shadow-color);
}

.section-title {
    color: var(--text);
    font-size: 18px;
}

.label {
    color: var(--text-subtle);
    font-size: 13px;
}

.text-primary {
    color: var(--text);
}

.text-white {
    color: #ffffff;
}
