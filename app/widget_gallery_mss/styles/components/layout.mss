/* === Layout === */

.header {
    background: var(--header-bg);
    height: 56px;
}

.sidebar {
    background: var(--sidebar-bg);
    border-right: 1px solid var(--border);
}

.gallery-sidebar {
    width: 230px;
    background: var(--sidebar-bg);
    border-right: 1px solid var(--border);
}

.content {
    background: var(--bg-base);
}
