/* === Dimensions === */

.input-width { width: 300px; }
.dropdown-width { width: 250px; }
.progress-height-sm { height: 8px; }
.progress-height-md { height: 12px; }
.swatch-size { width: 60px; height: 40px; }
.swatch-label { color: #ffffff; font-size: 11px; }
.anim-box-size { width: 50px; height: 50px; }
.anim-box-size-sm { width: 40px; height: 40px; }
.layout-box-size { width: 100px; height: 50px; }
.stack-box-lg { width: 120px; height: 80px; }
.stack-box-md { width: 100px; height: 60px; }
.stack-box-sm { width: 80px; height: 40px; }
.stack-label { color: #ffffff; font-size: 12px; }
.tab-text { font-size: 14px; }
.scroll-height { height: 160px; }
.slider-width { width: 300px; }
.progress-width { width: 300px; }

.scroll-container {
    background: var(--bg-base);
    border-radius: 8px;
    border: 1px solid var(--border);
}

.scroll-text {
    color: var(--text);
    font-size: 13px;
}
